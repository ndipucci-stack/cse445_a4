<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- Phone is any string, e.g. 928-638-7496 -->
  <xs:simpleType name="PhoneType">
    <xs:restriction base="xs:string" />
  </xs:simpleType>

  <!-- Rating is an optional decimal, e.g. 4.9 -->
  <xs:simpleType name="RatingType">
    <xs:restriction base="xs:decimal" />
  </xs:simpleType>

  <!-- Address: Number, Street, City, State, Zip (in this order), plus a required NearestAirport attribute -->
  <xs:complexType name="AddressType">
    <xs:sequence>
      <xs:element name="Number" type="xs:string" />
      <xs:element name="Street" type="xs:string" />
      <xs:element name="City" type="xs:string" />
      <xs:element name="State" type="xs:string" />
      <xs:element name="Zip" type="xs:string" />
    </xs:sequence>
    <xs:attribute name="NearestAirport" type="xs:string" use="required" />
  </xs:complexType>

  <!-- National park: Name, one or more Phone, Address (in this order), plus an optional Rating attribute -->
  <xs:complexType name="NationalParkType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" />
      <xs:element name="Phone" type="PhoneType" maxOccurs="unbounded" />
      <xs:element name="Address" type="AddressType" />
    </xs:sequence>
    <xs:attribute name="Rating" type="RatingType" use="optional" />
  </xs:complexType>

  <!-- Root: NationalParks contains one or more NationalPark -->
  <xs:element name="NationalParks">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NationalPark" type="NationalParkType" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
